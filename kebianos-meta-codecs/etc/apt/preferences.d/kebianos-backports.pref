# KebianOS: SOLO kernel y 0 A.D. desde trixie-backports.
# Todo lo demas se queda en trixie estable.
# Se usa n= (codename) porque a= vale "stable-backports" en estos repos.
#
#  - Por defecto NADA de backports se instala (prioridad 100).
#  - Solo los paquetes listados abajo suben a 990.
#  - Si necesitan una dependencia mas nueva, apt trae solo esa desde backports.

# Base: backports permitido pero nunca preferido
Package: *
Pin: release n=trixie-backports
Pin-Priority: 100

# Kernel + headers
Package: linux-image-amd64 linux-headers-amd64 linux-base
Pin: release n=trixie-backports
Pin-Priority: 990

# 0 A.D. (motor y datos deben ir en la misma version)
Package: 0ad 0ad-data 0ad-data-common
Pin: release n=trixie-backports
Pin-Priority: 990
